# Copy this file to ".env" and edit. NEVER upload .env to GitHub.
# Beginner default: SQLite (a single file, no install needed)
DATABASE_URL=sqlite:///./prayas.db
# PostgreSQL with Docker on your laptop (docker compose up -d):
# DATABASE_URL=postgresql+psycopg2://prayas:prayas_pw@localhost:5432/prayas
# SUPABASE (Project -> Connect -> copy the connection string; use the "Session pooler" one, port 5432):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# (a URL starting with postgresql:// or postgres:// is fine, the app fixes the prefix.
#  If your password has special characters like @ or #, URL-encode them, e.g. @ becomes %40.)
# Row Level Security lock-down for Supabase (leave true):
# ENABLE_RLS=true
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# --- Email alerts (leave SMTP_HOST empty in development: emails are saved to backend/outbox/) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=ResearchConnect <no-reply@yourdomain.com>
APP_URL=http://localhost:5173
MATCH_ALERT_THRESHOLD=0.30
MATCH_ALERT_MAX=3
